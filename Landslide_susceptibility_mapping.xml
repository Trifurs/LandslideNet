<startParam name="滑坡敏感性制图" language="python" version="cp311" system="win_amd64" description="使用卷积神经网络进行大尺度滑坡敏感性制图">
    <param>
        <name>input_factors_dir</name>
        <description>输入影响因子文件</description>
        <inout>in</inout>
        <type>folder</type>
        <info>20个滑坡影响因子（已归一化）的tif文件所在目录</info>
        <value>/home/whu/桌面/myData/LSM\origin\factors</value>
    </param>
    <param>
        <name>input_labels_dir</name>
        <description>输入标签文件夹</description>
        <inout>in</inout>
        <type>folder</type>
        <info>包含滑坡点（1）和非滑坡点（2）的tif影像</info>
        <value>/home/whu/桌面/myData/LSM\origin\label</value>
    </param>
    <param>
        <name>output_factors_dir</name>
        <description>输出经预处理后影响因子的文件夹</description>
        <inout>out</inout>
        <type>folder</type>
        <info>经裁剪等处理后的训练测试的特征影像所在目录</info>
        <value>/home/whu/桌面/myData/LSM\origin\cut\factor</value>
    </param>
    <param>
        <name>output_labels_dir</name>
        <description>输出经预处理后标签的文件夹</description>
        <inout>out</inout>
        <type>folder</type>
        <info>经裁剪等处理后的训练测试的标签所在目录</info>
        <value>/home/whu/桌面/myData/LSM\origin\cut\label</value>
    </param>
    <param>
        <name>crop_size</name>
        <description>影像裁剪尺寸</description>
        <inout>in</inout>
        <type>int</type>
        <info>裁剪后影像的长和宽</info>
        <value>512</value>
    </param>
    <param>
        <name>overlap</name>
        <description>裁剪时的重叠尺寸</description>
        <inout>in</inout>
        <type>int</type>
        <info>裁剪时相邻影像之间重叠的像素数量</info>
        <value>64</value>
    </param>
    <param>
        <name>train_output</name>
        <description>训练日志和权重的输出文件夹</description>
        <inout>out</inout>
        <type>folder</type>
        <info>训练日志和权重的输出文件夹</info>
        <value>/home/whu/桌面/myResult/LandslideNet\pth</value>
    </param>
    <param>
        <name>num_epochs</name>
        <description>训练轮数</description>
        <inout>in</inout>
        <type>int</type>
        <info>训练轮数</info>
        <value>2000</value>
    </param>
    <param>
        <name>lr</name>
        <description>学习率</description>
        <inout>in</inout>
        <type>float</type>
        <info>学习率</info>
        <value>0.001</value>
    </param>
    <param>
        <name>weight_decay</name>
        <description>L2正则化</description>
        <inout>in</inout>
        <type>float</type>
        <info>L2正则化</info>
        <value>0.001</value>
    </param>
    <param>
        <name>device_ids</name>
        <description>GPU编号</description>
        <inout>in</inout>
        <type>list</type>
        <info>模型训练时采用了两张GPU</info>
        <value>[0, 1]</value>
    </param>
    <param>
        <name>patience</name>
        <description>早停耐心参数</description>
        <inout>in</inout>
        <type>int</type>
        <info>早停耐心参数</info>
        <value>60</value>
    </param>
    <param>
        <name>batch_size</name>
        <description>批处理大小</description>
        <inout>in</inout>
        <type>int</type>
        <info>批处理大小</info>
        <value>8</value>
    </param>
    <param>
        <name>num_workers</name>
        <description>数据加载器的工作线程数</description>
        <inout>in</inout>
        <type>int</type>
        <info>数据加载器的工作线程数</info>
        <value>8</value>
    </param>
    <param>
        <name>num_bands</name>
        <description>输入影像的波段数</description>
        <inout>in</inout>
        <type>int</type>
        <info>输入影像的波段数，即影响因子的数目</info>
        <value>20</value>
    </param>
    <param>
        <name>LSM_dir</name>
        <description>滑坡敏感性地图输出文件夹</description>
        <inout>out</inout>
        <type>folder</type>
        <info>滑坡敏感性地图输出文件夹，还未处理接缝</info>
        <value>/home/whu/桌面/myResult/LandslideNet\LSM</value>
    </param>
    <param>
        <name>mosaic_map</name>
        <description>镶嵌消除接缝后的滑坡敏感性地图输出路径</description>
        <inout>out</inout>
        <type>file</type>
        <info>镶嵌消除接缝后的滑坡敏感性地图输出路径</info>
        <value>/home/whu/桌面/myResult/LandslideNet\LSM\mosaic\landslide_susceptibility_map.tif</value>
    </param>
</startParam>
