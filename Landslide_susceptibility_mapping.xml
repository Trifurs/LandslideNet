<?xml version="1.0" encoding="UTF-8"?>
<startParam name="LandslideNet regional experiments" version="2.1">
    <!-- Aligned full-resolution inputs -->
    <param><name>input_factors_dir</name><value>/home/whu/桌面/myData/LSM/origin/factors</value></param>
    <param><name>landslide_inventory</name><value>/home/whu/桌面/myData/LSM/origin/Landslide_label_buffer.tif</value></param>
    <param><name>num_bands</name><value>20</value></param>

    <!-- Frozen label-independent terrain-derived physiographic regions -->
    <param><name>macro_region_output</name><value>/home/whu/桌面/myData/LSM/origin/macro_regions/terrain_macro_regions_k{count}.tif</value></param>
    <param><name>macro_region_count</name><value>5</value></param>
    <param><name>macro_region_factors</name><value>DEM,Slope,Relief,Roughness,TPI,TWI</value></param>
    <param><name>macro_region_downsample</name><value>64</value></param>
    <param><name>macro_region_spatial_weight</name><value>1.5</value></param>
    <param><name>macro_region_sensitivity_counts</name><value>[4,5,6]</value></param>
    <param><name>macro_region_minimum_fraction</name><value>0.03</value></param>
    <param><name>macro_region_maximum_excluded_fraction</name><value>0.01</value></param>
    <param><name>macro_region_maximum_disconnected_fraction</name><value>0.005</value></param>
    <param><name>macro_region_write_plot</name><value>true</value></param>

    <!-- Fold-fitted feature processing. Never fit these mappings on validation/test regions. -->
    <param><name>frequency_ratio_factors</name><value>Geology:176,Soil:36,Earthquake:5</value></param>
    <param><name>frequency_ratio_smoothing</name><value>0.5</value></param>
    <param><name>frequency_ratio_log2_clip</name><value>4.0</value></param>

    <!-- Nested continuous-region split and low-support handling -->
    <param><name>regional_validation_strategy</name><value>support_aware</value></param>
    <param><name>regional_min_inner_training_positives</name><value>500</value></param>
    <param><name>regional_preferred_validation_positives</name><value>100</value></param>
    <param><name>regional_min_region_positives</name><value>1</value></param>
    <param><name>regional_balance_training_regions</name><value>true</value></param>
    <param><name>regional_balance_power</name><value>0.5</value></param>
    <param><name>regional_low_support_warning</name><value>30</value></param>
    <param><name>regional_adequate_support</name><value>100</value></param>
    <param><name>regional_bootstrap_replicates</name><value>1000</value></param>
    <param><name>regional_bootstrap_confidence</name><value>0.95</value></param>

    <!-- Reviewer control: only the training-negative rule differs between arms. -->
    <param><name>experiment_sampling_methods</name><value>dwss,random</value></param>
    <param><name>negative_ratio</name><value>1.0</value></param>
    <param><name>dwss_candidate_multiplier</name><value>10</value></param>
    <param><name>dwss_candidate_minimum</name><value>10000</value></param>
    <param><name>dwss_candidate_maximum</name><value>100000</value></param>
    <param><name>dwss_theta_min</name><value>0.55</value></param>
    <param><name>dwss_n_strata</name><value>3</value></param>
    <param><name>dwss_weight_power</name><value>1.0</value></param>
    <param><name>dwss_min_per_stratum</name><value>5</value></param>
    <param><name>dwss_max_prototypes</name><value>2000</value></param>
    <param><name>dwss_kde_chunk_size</name><value>2048</value></param>

    <!--
      Unified model selection. Use one model name, a comma-separated list,
      machine_learning/deep_learning/ablation/proposed, or all.
    -->
    <param><name>model</name><value>landslidenet</value></param>
    <param><name>experiment_seed</name><value>20250609</value></param>
    <param><name>selection_metric</name><value>f1</value></param>
    <param><name>threshold_metric</name><value>f1</value></param>
    <param><name>evaluation_tta</name><value>false</value></param>
    <param><name>classical_iterations</name><value>500</value></param>
    <param><name>classical_n_jobs</name><value>8</value></param>

    <!-- Shared deep-model training controls -->
    <param><name>crop_size</name><value>512</value></param>
    <param><name>batch_size</name><value>8</value></param>
    <param><name>num_workers</name><value>8</value></param>
    <param><name>num_epochs</name><value>300</value></param>
    <param><name>lr</name><value>0.001</value></param>
    <param><name>weight_decay</name><value>0.001</value></param>
    <param><name>patience</name><value>30</value></param>
    <param><name>device_ids</name><value>[0,1]</value></param>
    <param><name>raster_chunk_size</name><value>1024</value></param>
    <param><name>feature_tile_size</name><value>1024</value></param>

    <!-- A timestamped subdirectory is created unless an explicit output directory is supplied. -->
    <param><name>train_output</name><value>/home/whu/桌面/myResult/LandslideNet/regional_experiments</value></param>

    <!-- Step 3: full is the default deployment product; oof is validation-only. -->
    <param><name>prediction_map_type</name><value>full</value></param>
    <param><name>prediction_write_binary</name><value>false</value></param>
    <param><name>prediction_tile_size</name><value>1024</value></param>

    <!--
      Deep models must use MSMF. These five strides correspond to the upstream
      overlaps 128,80,55,199,175 for a 512-pixel window. Classical models bypass MSMF.
    -->
    <param><name>msmf_strides</name><value>[384,432,457,313,337]</value></param>
</startParam>
