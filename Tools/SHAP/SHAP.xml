<startParam name="滑坡敏感性制图" language="python" version="cp311" system="win_amd64" description="使用卷积神经网络进行大尺度滑坡敏感性制图">
    <param>
        <name>input_factors_dir</name>
        <description>输入影响因子文件</description>
        <inout>in</inout>
        <type>folder</type>
        <info>20个滑坡影响因子（已归一化）的tif文件所在目录</info>
        <value>S:\lb\myCode\LandslideNet\Data\type\DWSS\landslide\cropped_factors</value>
        <!-- <value>S:\lb\myCode\LandslideNet\Data\type\DWSS\landslide(debris slide)\cropped_factors</value> -->
        <!-- <value>S:\lb\myCode\LandslideNet\Data\type\DWSS\landslide(rock fall)\cropped_factors</value> -->
        <!-- <value>S:\lb\myCode\LandslideNet\Data\type\DWSS\unstable slope\cropped_factors</value> -->
    </param>
    <param>
        <name>input_labels_dir</name>
        <description>输入标签文件夹</description>
        <inout>in</inout>
        <type>folder</type>
        <info>包含滑坡点（1）和非滑坡点（2）的tif影像，用于制作训练集</info>
        <value>S:\lb\myCode\LandslideNet\Data\type\input\ls</value>
        <!-- <value>S:\lb\myCode\LandslideNet\Data\type\input\ds</value> -->
        <!-- <value>S:\lb\myCode\LandslideNet\Data\type\input\rf</value> -->
        <!-- <value>S:\lb\myCode\LandslideNet\Data\type\input\us</value> -->
    </param>
    <param>
        <name>output_factors_dir</name>
        <description>输出训练样本的文件夹</description>
        <inout>out</inout>
        <type>folder</type>
        <info>存放提取出的.npy格式的Patch样本（分train/val）</info>
        <value>S:\lb\myCode\LandslideNet\Data\type\output\ls\patches</value>
        <!-- <value>S:\lb\myCode\LandslideNet\Data\type\output\ds\patches</value> -->
        <!-- <value>S:\lb\myCode\LandslideNet\Data\type\output\rf\patches</value> -->
        <!-- <value>S:\lb\myCode\LandslideNet\Data\type\output\us\patches</value> -->
    </param>
    <param>
        <name>output_labels_dir</name>
        <description>输出训练标签的文件夹</description>
        <inout>out</inout>
        <type>folder</type>
        <info>存放提取出的标签（分train/val）</info>
        <value>S:\lb\myCode\LandslideNet\Data\type\output\ls\labels</value>
        <!-- <value>S:\lb\myCode\LandslideNet\Data\type\output\ds\labels</value> -->
        <!-- <value>S:\lb\myCode\LandslideNet\Data\type\output\rf\labels</value> -->
        <!-- <value>S:\lb\myCode\LandslideNet\Data\type\output\us\labels</value> -->
    </param>
    <param>
        <name>crop_size</name>
        <description>模型输入的Patch尺寸</description>
        <inout>in</inout>
        <type>int</type>
        <info>训练和预测时使用的窗口大小（如512）</info>
        <value>512</value>
    </param>
    <param>
        <name>train_output</name>
        <description>训练日志和权重的输出文件夹</description>
        <inout>out</inout>
        <type>folder</type>
        <info>训练日志和权重的输出文件夹</info>
        <value>S:\lb\myCode\LandslideNet\Data\type\output\pth</value>
    </param>
    <param>
        <name>num_bands</name>
        <description>输入影像的波段数</description>
        <inout>in</inout>
        <type>int</type>
        <info>输入影像的波段数，即影响因子的数目</info>
        <value>20</value>
    </param>
</startParam>
